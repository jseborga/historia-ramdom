# Copia estas variables en la seccion Environment de Easypanel.
# Nunca las subas al repositorio.
#
# Las variables que dejes en blanco se ignoran: puedes copiar el archivo entero
# y rellenar solo las que uses.
#
# Cualquiera de las variables marcadas con [cifrable] admite el formato
#   NOMBRE=enc:<iv>.<tag>.<datos>
# generado con:  node dist/scripts/cifrar-secreto.js
# La app las descifra al arrancar con ENCRYPTION_KEY, que siempre va en claro.

NODE_ENV=production
PORT=3000
PUBLIC_URL=https://estudio.tudominio.com

# [cifrable] Easypanel nombra los servicios internos como <proyecto>_<servicio>
DATABASE_URL=postgres://postgres:CLAVE_LARGA@estudio_postgres:5432/estudio
# [cifrable]
REDIS_URL=redis://default:CLAVE_LARGA@estudio_redis:6379

DATA_DIR=/data
# openssl rand -base64 32   (nunca se cifra: es la clave que descifra al resto)
ENCRYPTION_KEY=

# --- Login maestro -----------------------------------------------------------
# Se crea o actualiza en cada arranque. Prefiere el hash: la contrasena en claro
# nunca deberia vivir en el panel.
#   node dist/scripts/cifrar-secreto.js --password
ADMIN_EMAIL=
# [cifrable]
ADMIN_PASSWORD_HASH=
# [cifrable] Alternativa rapida al hash, solo para el primer arranque.
ADMIN_PASSWORD=

# --- Acceso de clientes sin navegador (servidor MCP) -------------------------
# [cifrable] Token largo enviado como "Authorization: Bearer ...".
# Generalo con: openssl rand -hex 32   (vacio = solo se entra con la cookie)
API_TOKEN=

# --- Limites -----------------------------------------------------------------
# Tamano maximo de cada clip descargado y del MP4 ya compilado, en megabytes.
MAX_CLIP_MB=150
MAX_VIDEO_MB=300
# Tope de un videoclip musical en segundos (encadena varias canciones).
# Las historias siguen con su tope de 350 s.
MAX_VIDEOCLIP_SEG=900
# Dias que se conservan los MP4 antes de la limpieza diaria
RETENCION_DIAS=15

# --- Proveedores de guion (usa los que tengas) -------------------------------
# [cifrable]
ANTHROPIC_API_KEY=
# [cifrable] Google AI Studio
GEMINI_API_KEY=
# [cifrable]
OPENAI_API_KEY=
# [cifrable]
GROQ_API_KEY=

# Modelos por defecto. Los proveedores los renuevan a menudo; se pueden afinar
# ademas por serie y por historia desde la propia interfaz.
ANTHROPIC_MODELO=claude-opus-5
GEMINI_MODELO=gemini-2.5-flash
OPENAI_MODELO=gpt-4o-mini
GROQ_MODELO=llama-3.3-70b-versatile

# Voz local del servidor (espeak-ng). Es la voz POR DEFECTO: sin clave, sin red,
# algo robotica. Voces: es-419 (Latinoamerica), es (Espana), en-us, en-gb...
VOZ_LOCAL_VOZ=es-419
# Palabras por minuto, entre 80 y 300
VOZ_LOCAL_VELOCIDAD=150
# Piper (voz neural local). El Dockerfile lo deja aqui; cambia solo si lo mueves.
PIPER_BIN=/opt/piper/piper
PIPER_VOCES=/opt/piper/voces

# Voz de IA (Google AI Studio y OpenAI), cuando se quiera algo mejor
GEMINI_MODELO_VOZ=gemini-2.5-flash-preview-tts
GEMINI_VOZ=Kore
OPENAI_MODELO_VOZ=gpt-4o-mini-tts
OPENAI_VOZ=coral

# --- Clips -------------------------------------------------------------------
# [cifrable]
PEXELS_API_KEY=
# [cifrable]
PIXABAY_API_KEY=

# --- Reddit como detector de temas (opcional, apagado por defecto) -----------
# Ojo: el nivel gratuito de la API es para uso NO comercial. Monetizar el canal
# es uso comercial y requiere acuerdo previo con Reddit.
REDDIT_ACTIVO=false
# [cifrable]
REDDIT_CLIENT_ID=
# [cifrable]
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=estudio-voz-en-off/1.0 (by /u/tuusuario)
REDDIT_SUBS_ES=PreguntaleAReddit,es
REDDIT_SUBS_EN=AskReddit,tifu,ShortStories
REDDIT_PUNTOS_MINIMOS=500
REDDIT_CRON=0 6 * * *

# --- Paginas legales (Terminos y Privacidad) --------------------------------
# Se sirven en /terminos y /privacidad, publicas y sin login: son las dos URL
# que piden TikTok y Amazon para aprobar la aplicacion. Sin estas variables las
# paginas salen igual, pero avisando de que no identifican a nadie.
LEGAL_TITULAR=
LEGAL_CONTACTO=
LEGAL_JURISDICCION=Bolivia

# --- TikTok (opcional) -------------------------------------------------------
# Permisos que se piden al conectar. Anade video.publish solo cuando TikTok te
# apruebe la publicacion directa. Si cambias esto, reconecta la cuenta.
TIKTOK_SCOPES=user.info.basic,video.upload,video.list
# Contenido EXACTO del archivo de verificacion de dominio que te descargas en
# el portal de TikTok ("Verify URL properties"), en una sola linea. La app lo
# sirve en https://tu-dominio/tiktok<codigo>.txt. Sin esto, esa direccion la
# atiende el frontend y devuelve HTML: TikTok la da por no verificada.
TIKTOK_VERIFICACION=
# [cifrable]
TIKTOK_CLIENT_KEY=
# [cifrable]
TIKTOK_CLIENT_SECRET=
# Si se deja vacio, se deduce de PUBLIC_URL: <PUBLIC_URL>/api/tiktok/callback
TIKTOK_REDIRECT_URI=

# Openverse funciona sin registrarse (20 peticiones/minuto, 200/dia). Con un
# token de su API esos limites suben; Wikimedia Commons e Internet Archive no
# piden nada.
OPENVERSE_TOKEN=

# --- Amazon Afiliados (opcional) ---------------------------------------------
# Para la pestana Producto. Las fotos y los datos de un producto SOLO pueden
# salir de la API oficial (Product Advertising API v5) y solo con una cuenta de
# Afiliados aprobada: bajarlas de la ficha publica esta prohibido.
# Sin las dos claves la pestana sigue sirviendo (se pega el enlace del producto
# y se saca el ASIN), pero no habra fotos ni fichas.
# [cifrable]
AMAZON_ACCESS_KEY=
# [cifrable]
AMAZON_SECRET_KEY=
# La etiqueta de afiliado ("miweb-21"). Sin ella los enlaces no dan comision.
AMAZON_PARTNER_TAG=
# Tienda por defecto: com, es, com.mx, com.br, co.uk, de, fr, it o ca.
AMAZON_MERCADO=com
