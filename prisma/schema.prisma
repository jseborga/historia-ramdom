generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  maestro      Boolean   @default(false) // creado desde ADMIN_EMAIL / ADMIN_PASSWORD
  sessions     Session[]
  createdAt    DateTime  @default(now())
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime

  @@index([expiresAt])
}

enum ModoPublicacion {
  DESCARGA // solo deja el MP4 listo
  BORRADOR_TIKTOK // lo envia a borradores de TikTok
  DIRECTO_TIKTOK // publicacion directa (requiere auditoria)
}

enum EstadoIdea {
  PENDIENTE
  USADA
  DESCARTADA
}

enum FuenteIdea {
  MANUAL
  IA
  REDDIT
}

/// El video y la voz no tienen que ir a la par: se pueden separar o quitar.
enum ModoAudio {
  VOZ // narracion generada, y la escena dura lo que dura su audio
  MUSICA // sin narracion: solo subtitulos y musica de fondo
  MUDO // sin sonido; la duracion sale del texto
}

enum ModoMusica {
  FIJA
  ROTAR
}

enum FuenteMetrica {
  API // TikTok Display API
  MANUAL // copiado a mano desde TikTok Studio
}

enum EstadoHistoria {
  GUION
  CLIPS
  VOZ
  RENDER
  LISTA
  SUBIDA
  MONTAJE // esperando en el editor, con los clips precargados
  ERROR
}

/// Que produce cada ejecucion de la serie.
enum SalidaSerie {
  VIDEO // el MP4 terminado, como siempre
  MONTAJE // un proyecto en el editor, para revisar y probar antes de renderizar
}

model Serie {
  id              String          @id @default(uuid())
  nombre          String
  tipo            String // "Reflexion" o "Historia"
  temas           String[] // lista de temas; vacia = tema libre
  duracion        Int             @default(65)
  cron            String // ej. "0 9 * * *" = todos los dias a las 9:00
  zonaHoraria     String          @default("America/Lima")
  idioma          String          @default("es")
  /// Variante regional del texto: bolivia, latam o eeuu.
  region          String          @default("bolivia")
  /// Usar modismos propios de la región (o español neutro si es false).
  modismos        Boolean         @default(true)
  /// Historias por partes: cuántas partes seguidas produce cada ejecución.
  partes          Int             @default(1)
  /// Bancos donde buscar imagen: pexels, pixabay, nasa. Vacío = los de la categoría.
  bancos          String[]        @default([])
  /// Medios admitidos: video, imagen. Vacío = lo que use la categoría.
  medios          String[]        @default([])
  /// Categoría de historia: id fijo, "aleatoria" (una distinta cada vez) o vacío (tema libre).
  categoria       String?
  /// Subcategoría fija; vacía = una al azar dentro de la categoría.
  subcategoria    String?
  motor           String          @default("groq")
  modelo          String? // modelo concreto del motor; vacio = el del entorno
  voz             Json // { proveedor, modelo, nombre }
  musica          String? // nombre de archivo dentro de DATA_DIR/musica
  musicaModo      ModoMusica      @default(FIJA) // ROTAR va cambiando de pista
  modoAudio       ModoAudio       @default(VOZ)
  /// Segundos por escena cuando no hay voz; vacio = se calcula por el texto.
  segundosEscena  Float?
  modoPublicacion ModoPublicacion @default(DESCARGA)
  salida          SalidaSerie     @default(VIDEO)
  activa          Boolean         @default(true)
  historias       Historia[]
  creadaEn        DateTime        @default(now())
}

model Historia {
  id          String         @id @default(uuid())
  serie       Serie?         @relation(fields: [serieId], references: [id], onDelete: SetNull)
  serieId     String?
  idea        Idea?          @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  ideaId      String?
  gancho      Gancho?        @relation(fields: [ganchoId], references: [id], onDelete: SetNull)
  ganchoId    String?
  ganchoTexto String?
  /// Parte N de una historia continuada; 1 si es única.
  parte       Int            @default(1)
  /// Historia anterior de la que esta es continuación.
  continuaDeId String?
  estado      EstadoHistoria @default(GUION)
  titulo      String?
  /// Con qué categoría y subcategoría se planteó (el planteamiento va dentro de `guion`).
  categoria   String?
  subcategoria String?
  guion       Json?
  escenas     Json? // texto, keywords, clip (id, fuente, autor, pagina, licencia), duracion
  descripcion String? // texto final para TikTok con creditos
  archivo     String? // nombre del MP4 dentro de DATA_DIR/videos
  musica      String? // pista usada, para no repetirla en la siguiente
  modoAudio   ModoAudio      @default(VOZ)
  publishId   String?
  videoTikTok String? // id publico del video, para pedir sus metricas
  publicarEn  DateTime? // subida programada a TikTok
  error       String?
  metrica     Metrica?
  proyectos   Proyecto[]
  creadaEn    DateTime       @default(now())

  @@index([serieId, creadaEn])
  @@index([estado])
}

enum EstadoProyecto {
  BORRADOR
  MONTAJE // armando las pistas (videoclip): analisis de la letra y busqueda de clips
  RENDER
  LISTO
  ERROR
}

/// Que gobierna el montaje: la narracion de una historia o una cancion.
enum TipoProyecto {
  NARRACION // historias con voz en off (lo de siempre)
  MUSICA // videoclip: manda la musica y no hay narracion
}

/// Proyecto de edicion: la linea de tiempo que se monta en el editor.
model Proyecto {
  id         String          @id @default(uuid())
  historia   Historia?       @relation(fields: [historiaId], references: [id], onDelete: SetNull)
  historiaId String?
  nombre     String
  tipo       TipoProyecto    @default(NARRACION)
  /// Videoclip: letra o lineamientos, tramos detectados y criterios de imagen.
  letra      Json?
  /// Id de preset de formato (tiktok, youtube, cuadrado...).
  formato    String          @default("tiktok")
  /// Pista de video: clips en secuencia, cada uno con su duracion y efecto.
  escenas    Json
  /// Pista de textos: rotulos con inicio y duracion propios, independientes de los clips.
  textos     Json            @default("[]")
  /// Pista de voz: { modo: "ninguna" | "servidor" | "archivo", texto, config, archivo, duracion, inicio }
  voz        Json?
  /// Capa de musica: { archivo, volumen }
  musica     Json?
  archivo    String? // MP4 final dentro de DATA_DIR/videos
  /// Título, hashtags y créditos de los clips, listo para pegar al publicar.
  descripcion String?
  duracionSeg Float?
  /// Perfil de compresión del render: alta, normal o ligera.
  calidad    String          @default("normal")
  /// Lo que pesó el MP4. Sirve para afinar la estimación de los siguientes.
  bytes      Float?
  estado     EstadoProyecto  @default(BORRADOR)
  error      String?
  variantes  Variante[]
  creadoEn   DateTime        @default(now())
  editadoEn  DateTime        @updatedAt

  @@index([estado, editadoEn])
}

/// Un corte o formato alternativo del MISMO montaje: la version completa en
/// 16:9, los 30 segundos del coro en 9:16... Cada una se renderiza y se
/// descarga aparte, sin tocar el proyecto.
model Variante {
  id          String         @id @default(uuid())
  proyecto    Proyecto       @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  proyectoId  String
  nombre      String
  /// Id de preset de formato de esta salida.
  formato     String         @default("tiktok")
  /// Segundo del montaje por el que empieza el corte.
  inicio      Float          @default(0)
  /// Segundos que dura; vacio = hasta el final del montaje.
  duracion    Float?
  archivo     String? // MP4 dentro de DATA_DIR/videos
  duracionSeg Float?
  /// Perfil de compresión de este corte; vacío = el del proyecto.
  calidad     String?
  bytes       Float?
  estado      EstadoProyecto @default(BORRADOR)
  error       String?
  creadaEn    DateTime       @default(now())

  @@index([proyectoId, creadaEn])
}

/// Banco de historias: ideas listas para convertirse en video.
model Idea {
  id         String     @id @default(uuid())
  titulo     String
  tema       String
  idioma     String     @default("es")
  fuente     FuenteIdea @default(MANUAL)
  refExterna String?    @unique // enlace de origen; evita duplicados
  notas      String?
  estado     EstadoIdea @default(PENDIENTE)
  puntuacion Float? // media de las historias que salieron de aqui
  usos       Int        @default(0)
  historias  Historia[]
  creadaEn   DateTime   @default(now())

  @@index([estado, puntuacion])
  @@index([idioma])
}

/// Ganchos reutilizables: los que mejor retienen se vuelven a usar.
model Gancho {
  id         String     @id @default(uuid())
  texto      String
  idioma     String     @default("es")
  usos       Int        @default(0)
  puntuacion Float?
  historias  Historia[]
  creadoEn   DateTime   @default(now())

  @@unique([texto, idioma])
  @@index([puntuacion])
}

/// Rendimiento de una historia ya publicada.
model Metrica {
  id                String        @id @default(uuid())
  historia          Historia      @relation(fields: [historiaId], references: [id], onDelete: Cascade)
  historiaId        String        @unique
  vistas            Int           @default(0)
  likes             Int           @default(0)
  comentarios       Int           @default(0)
  compartidos       Int           @default(0)
  guardados         Int           @default(0)
  duracionSeg       Float?
  /// TikTok no lo expone por API: se copia a mano desde TikTok Studio.
  tiempoPromedioSeg Float?
  puntuacion        Float?
  fuente            FuenteMetrica @default(MANUAL)
  actualizadaEn     DateTime      @updatedAt

  @@index([puntuacion])
}

model TikTokCuenta {
  id              String   @id @default(uuid())
  openId          String   @unique
  nombre          String?
  accessTokenEnc  String // cifrado con AES-256-GCM
  refreshTokenEnc String
  expiraEn        DateTime
  scopes          String
  creadaEn        DateTime @default(now())
}

/// Vídeo o foto de la biblioteca: lo que se sube y lo que se guarda de los bancos.
enum ClaseMedio {
  VIDEO
  IMAGEN
}

/// Biblioteca de material propio y guardado, para componer vídeos sin volver a buscar.
model Medio {
  id        String     @id @default(uuid())
  clase     ClaseMedio
  /// Nombre del archivo dentro de DATA_DIR/medios; se genera en el servidor.
  archivo   String     @unique
  nombre    String
  /// De dónde salió: subido, pexels, pixabay o nasa.
  fuente    String     @default("subido")
  autor     String?
  pagina    String?
  licencia  String?
  /// Id en el banco de origen, para no guardar dos veces lo mismo.
  externoId String?
  duracion  Float?
  ancho     Int?
  alto      Int?
  bytes     Float?
  etiquetas String[]   @default([])
  creadoEn  DateTime   @default(now())

  @@index([clase, creadoEn])
  @@index([externoId])
}
